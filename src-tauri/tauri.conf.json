{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nekara Launcher",
  "version": "0.1.11",
  "identifier": "com.nekara.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDMERBNzY2NTVGNjlGQjUKUldTMW4vWlZacWNON0lNSmlBU01GeEpTYmE4NCt5dUtac1JKbUhtUTZFMHpsVk9GZlBxUklwakUK",
      "endpoints": [
        "https://github.com/Jonaczech/nekara-launcher/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "windows": [
      {
        "title": "Nekara Launcher",
        "width": 1100,
        "height": 720,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
