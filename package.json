{
  "name": "nekara-launcher",
  "private": true,
  "version": "0.1.34",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"README.md\" \"brand/**/*.md\" \"docs/**/*.md\" \".github/**/*.{yml,yaml}\" \"src/**/*.{ts,tsx,css}\" \"src/assets/**/*.md\" \"package.json\" && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check \"README.md\" \"brand/**/*.md\" \"docs/**/*.md\" \".github/**/*.{yml,yaml}\" \"src/**/*.{ts,tsx,css}\" \"src/assets/**/*.md\" \"package.json\" && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "lint": "pnpm typecheck && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "build": "tsc && vite build",
    "check": "pnpm format:check && pnpm lint && pnpm test && pnpm build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "lucide-react": "^1.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
